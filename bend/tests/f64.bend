# F64 against Go (golden/f64.txt, from scripts/gen-f64-golden.go)
import Base
import ../lib/big.bend as Big
import ../lib/dec.bend as Dec
import ../lib/f64.bend as F64

def bdig.go(s: String, +acc: Big.Big) -> Big.Big:
  match s:
    case SNil{}:
      acc
    case SCon{+c, +rest}:
      bdig.go(rest, Big.add(Big.mul(acc, Big.of(10n)), Big.of(Dec.digit(c))))

def f(+s: String) -> F64.F64:
  F64.of_big(bdig.go(s, Big.of(0n)))

def fq(+p: String, +q: String) -> F64.F64:
  F64.div(f(p), f(q))

def div(+p: String, +q: String) -> String:
  +x = fq(p, q)
  "div " ++ p ++ " " ++ q ++ " " ++ F64.fixed(0n, x) ++ " " ++ F64.fixed(2n, x) ++ " " ++ F64.fixed(6n, x) ++ " " ++ F64.json(x)

def quad(+op: String, +a: String, +b: String, +c: String, +d: String, +x: F64.F64) -> String:
  op ++ " " ++ a ++ " " ++ b ++ " " ++ c ++ " " ++ d ++ " " ++ F64.json(x)

def add(+a: String, +b: String, +c: String, +d: String) -> String:
  quad("add", a, b, c, d, F64.add(fq(a, b), fq(c, d)))

def mul(+a: String, +b: String, +c: String, +d: String) -> String:
  quad("mul", a, b, c, d, F64.mul(fq(a, b), fq(c, d)))

def ddv(+a: String, +b: String, +c: String, +d: String) -> String:
  quad("ddv", a, b, c, d, F64.div(fq(a, b), fq(c, d)))

def tr(+p: String, +q: String) -> String:
  "trunc " ++ p ++ " " ++ q ++ " " ++ Nat.show(F64.trunc(F64.mul(fq(p, q), F64.of_nat(1000000000n))))

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(div("0", "1"))
    IO.print(div("1", "3"))
    IO.print(div("2", "3"))
    IO.print(div("10", "4"))
    IO.print(div("1", "8"))
    IO.print(div("5", "1000"))
    IO.print(div("194329", "2"))
    IO.print(div("3", "7"))
    IO.print(div("1000000", "3"))
    IO.print(div("1", "1000000000"))
    IO.print(div("123456789", "1000"))
    IO.print(div("7", "3"))
    IO.print(div("125", "1000"))
    IO.print(div("135", "1000"))
    IO.print(div("4503599627370496", "3"))
    IO.print(div("999999999999", "1000000000"))
    IO.print(div("1", "7000000"))
    IO.print(div("1000000000000000000000", "1"))
    IO.print(div("30000000000000000000000", "7"))
    IO.print(div("5", "2"))
    IO.print(div("7", "2"))
    IO.print(div("1", "2"))
    IO.print(div("3", "8"))
    IO.print(div("1", "1000000"))
    IO.print(div("999999", "1000000000000"))
    IO.print(div("1", "10"))
    IO.print(div("123", "1"))
    IO.print(div("999999999999999999999", "1"))
    IO.print(div("12345678901234567890123", "1"))
    IO.print(div("1", ""))
    IO.print(div("9007199254740993", "1"))
    IO.print(div("25833", "1"))
    IO.print(div("364103", "1000"))
    IO.print(div("17", "1024"))
    IO.print(add("1", "10", "2", "10"))
    IO.print(add("1", "3", "2", "3"))
    IO.print(add("1", "1000000", "1", "10000000"))
    IO.print(add("4503599627370496", "1", "1", "2"))
    IO.print(add("9007199254740992", "1", "1", "1"))
    IO.print(add("9007199254740992", "1", "3", "1"))
    IO.print(mul("1", "10", "2", "10"))
    IO.print(mul("1", "3", "2", "3"))
    IO.print(mul("1", "1000000", "1", "10000000"))
    IO.print(mul("4503599627370496", "1", "1", "2"))
    IO.print(mul("9007199254740992", "1", "1", "1"))
    IO.print(mul("9007199254740992", "1", "3", "1"))
    IO.print(ddv("1", "", "100000000000000000000000", "1"))
    IO.print(ddv("3", "", "10000000000", "1"))
    IO.print(ddv("1", "", "1000000000000000000000000", "1"))
    IO.print(ddv("7", "", "100000000", "3"))
    IO.print(tr("3", "2"))
    IO.print(tr("1", "3"))
    IO.print(tr("2", "3"))
    IO.print(tr("7", "10"))
    IO.print(tr("281473", "1"))
    IO.print(tr("1", "1000000000"))

